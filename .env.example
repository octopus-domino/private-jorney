# Бэкенд CoDoc: исторические дома + пешеходные маршруты
VITE_CODOC_API_URL=https://www.codoc.site
# JWT для запросов от авторизованного пользователя (опционально)
VITE_CODOC_TOKEN=
# Все точки интереса загружаются с codoc.site.
# Photon — тот же геокодер, что использует бэк
VITE_PHOTON_URL=https://photon.komoot.io/api
# 1 — использовать mock вместо сетевых вызовов
VITE_MOCK=0

# Android читает внешние источники внутри APK через PublicSources/Chromium.
# Дополнительный бэкенд и адрес прокси для приложения не нужны.
# Только для локального Vite dev-прокси: HISTORY_PYTHON — путь к Python.

# Official Moscow house data; supplied to the client build
VITE_MOS_DATA_API_KEY=
